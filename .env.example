NODE_ENV=development
PORT=5000
SERVICE_NAME=my-service
SERVICE_VERSION=0.1.0
LOG_LEVEL=info
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
SHUTDOWN_TIMEOUT_MS=10000

# Persistence. Use memory only for tests or quick local experiments.
DATABASE_PROVIDER=memory
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/backend_starter
DATABASE_POOL_MAX=10

# Authentication. Generate independent secrets with: openssl rand -base64 48
AUTH_ENABLED=true
ACCESS_TOKEN_SECRET=replace-with-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
PASSWORD_SCRYPT_COST=16384

# Used only by the explicit seed:admin command; remove the password afterward.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=System
BOOTSTRAP_ADMIN_LAST_NAME=Administrator

# Background jobs. Use inline locally and BullMQ with Redis in production.
QUEUE_PROVIDER=inline
QUEUE_NAME=background-jobs
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=5

# Email. Console prints metadata locally; SMTP sends real email.
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Storage. Local is development-only; S3 works with AWS, R2, MinIO and compatible vendors.
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=uploads
S3_REGION=us-east-1
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=

# Observability — all integrations are optional and disabled by default.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORT_INTERVAL_MS=60000
METRICS_ENABLED=true
METRICS_TOKEN=

# Resilience defaults
OUTBOUND_TIMEOUT_MS=10000
OUTBOUND_RETRY_ATTEMPTS=3
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
